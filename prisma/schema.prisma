generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String?
  passwordHash   String?
  authProviderId String?  @unique
  avatarUrl      String?
  isAdmin        Boolean  @default(false)
  onboardingDone Boolean  @default(false)
  emailVerified  Boolean  @default(false)
  emailVerifiedAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  profile        UserProfile?
  preferences    UserPreference?
  resumes        Resume[]
  runs           ApplicationRun[]
  applications   Application[]
  usageEvents    AIUsageEvent[]
  subscription   Subscription?
  jobs           Job[]
  subscriptionEvents SubscriptionEvent[]
  jobsSeen       UserJobSeen[]
}

// ─── Profile ─────────────────────────────────────────────────────────────────

// The single store of GENERIC, reusable application data — the answers to the
// common questions every no-login ATS (Greenhouse/Lever/Ashby/Workable) asks, so
// the user fills them once. Role-/job-specific answers are NOT stored here; they
// live per-application in ApplicationAnswer.
model UserProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Identity
  fullName         String
  legalFirstName   String?
  legalLastName    String?
  preferredName    String?

  // Contact / address (email lives on User)
  phone            String?
  location         String?   // free-form "City, State" convenience field
  addressLine1     String?
  addressLine2     String?
  city             String?
  state            String?
  zipCode          String?
  country          String?

  // Links
  linkedinUrl      String?
  githubUrl        String?
  portfolioUrl     String?
  personalWebsite  String?

  // Work authorization
  workAuthorization String?
  requiresSponsorship Boolean?
  visaStatus       String?

  // Employment
  currentEmployer  String?
  currentTitle     String?
  yearsExperience  Int?
  // Candidate level + skill taxonomy used by hard gates + factor scoring
  // (seniorityBand: entry|junior_associate|early_mid|mid_senior|senior|staff_lead|principal_executive)
  seniorityBand    String?
  toolsJson        Json     @default("[]")
  cloudPlatformsJson Json   @default("[]")
  secondarySkillsJson Json  @default("[]")
  domainsJson      Json     @default("[]")
  industriesJson   Json     @default("[]")

  // Education
  highestEducation String?   // e.g. Bachelor's, Master's
  school           String?
  degree           String?
  major            String?
  graduationYear   String?

  // Logistics / preferences that appear on application forms
  willingToRelocate Boolean?
  noticePeriod     String?
  availabilityToStart String?
  desiredSalary    String?
  coverLetterPreference String?  // always | when_requested | never

  // Sourcing
  howHeard         String?
  referralName     String?
  referralSource   String?

  // EEO / voluntary self-identification (stored only if the user provides them;
  // intentionally NOT auto-filled as standard fields — surfaced for the user).
  gender           String?
  raceEthnicity    String?
  veteranStatus    String?
  disabilityStatus String?

  // Consent
  consentToDataProcessing Boolean @default(false)
  consentAt        DateTime?

  // Free-form summary + parsed-resume structured blocks
  summary          String?  @db.Text
  skillsJson       Json     @default("[]")
  educationJson    Json     @default("[]")
  experienceJson   Json     @default("[]")
  projectsJson     Json     @default("[]")
  certificationsJson Json   @default("[]")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model UserPreference {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetRolesJson      Json     @default("[]")
  acceptableAdjacentRolesJson Json @default("[]")
  excludedRolesJson    Json     @default("[]")
  employmentTypePreferenceJson Json @default("[]")
  preferredSourcesJson Json     @default("[]")
  excludedSourcesJson  Json     @default("[]")
  targetCompaniesJson  Json     @default("[]")
  blockedCompaniesJson Json     @default("[]")
  locationsJson        Json     @default("[]")
  remotePreference     String   @default("any")
  minSalary            Int?
  maxSalary            Int?
  yearsExperienceTarget Int?
  applicationsPerDay   Int      @default(10)
  approvalMode         ApprovalMode @default(ALWAYS_REVIEW)
  matchThreshold       Int      @default(70)
  atsPreferencesJson   Json     @default("{}")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

enum ApprovalMode {
  AUTO_APPLY
  ASSISTED_APPLY
  ALWAYS_REVIEW
  DRAFT_ONLY
}

// ─── Resume ──────────────────────────────────────────────────────────────────

model Resume {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName         String
  originalFileUrl  String
  fileType         String
  rawText          String?         @db.Text
  parsedJson       Json?
  isPrimary        Boolean         @default(false)
  version          Int             @default(1)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  versions         ResumeVersion[]
  applications     Application[]
}

model ResumeVersion {
  id         String   @id @default(cuid())
  resumeId   String
  resume     Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  version    Int
  fileUrl    String
  notes      String?
  createdAt  DateTime @default(now())
}

// ─── Artifact storage ─────────────────────────────────────────────────────────
// Generated document bytes (tailored resumes, packages, …) stored in-DB so the
// product needs no external object store: files survive container restarts and
// the whole app is a single Postgres. `key` is the addressable storage key
// (e.g. applications/<userId>/<jobId>/tailored_resume.docx) served via /api/files.
model Artifact {
  key       String   @id
  userId    String?
  mimeType  String
  data      Bytes
  size      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ─── Audit log ────────────────────────────────────────────────────────────────
// Append-only record of sensitive account-level operations (data export, account
// deletion, …). `userId` is a bare string with NO foreign key on purpose, so the
// entry SURVIVES the user's own deletion — a defensible GDPR deletion trail.
model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  detail    String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action])
}

// ─── Jobs ────────────────────────────────────────────────────────────────────

model JobSource {
  id        String   @id @default(cuid())
  name      String   @unique
  baseUrl   String?
  platform  String
  isActive  Boolean  @default(true)
  // Platform-specific params (e.g. Workday host/tenant/site) for the registry.
  configJson Json?
  // Verification/health — populated as the ingestor crawls boards. Drives crawl
  // rotation (least-recently-checked first) and auto-deactivation of dead boards.
  lastCheckedAt DateTime?
  lastSuccessAt DateTime?
  activeJobCount Int?
  createdAt DateTime @default(now())
  jobs      Job[]
  postings  JobPosting[]

  @@index([isActive, lastCheckedAt])
}

// Admin-configurable per-source settings for the PAID Apify scraper track. The
// admin dashboard toggles `enabled` and sets `maxJobsPerRun` (the cost cap passed
// to each actor). Jobright has no actor → its row stays disabled.
model ScraperSourceConfig {
  id            String   @id @default(cuid())
  sourceKey     String   @unique // linkedin | indeed | hiringcafe | jobright
  enabled       Boolean  @default(false)
  maxJobsPerRun Int      @default(25)
  notesJson     Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── Global job pool ─────────────────────────────────────────────────────────
// One row per real-world posting, user-agnostic and deduped across ALL sources
// and ALL users (vs. the per-user `Job` rows). Written by the scheduled global
// ingestor; read by per-user candidate generation (vector ANN + hard filters).
// This is the "daily dump all jobs into one location" pool.
model JobPosting {
  id                String   @id @default(cuid())
  sourceId          String?
  source            JobSource? @relation(fields: [sourceId], references: [id])

  // Provenance
  sourceName        String?  // greenhouse | lever | ashby | workable | remotive | remoteok | adzuna | themuse | usajobs | arbeitnow | linkedin | indeed | hiringcafe
  sourceJobId       String?
  atsPlatform       String?
  jobUrl            String?
  applyUrl          String?
  companyCareerUrl  String?
  // Cross-source canonicalization (spec Pt 8). canonicalKey is source-agnostic so
  // the same role from multiple sources can be collapsed; sourceCount/primarySource
  // track how many sources saw it and which is the best apply path.
  canonicalKey      String?
  sourceCount       Int      @default(1)
  primarySource     String?

  // Core fields (same shape as Job, minus userId/runId)
  title             String
  normalizedTitle   String?
  company           String
  companyDomain     String?
  department        String?
  industry          String?
  location          String?
  isRemote          Boolean?
  remoteType        String?  // onsite | hybrid | remote | unknown
  employmentType    String?
  seniority         String?

  // Compensation
  salaryMin         Int?
  salaryMax         Int?
  salaryCurrency    String?
  salaryPeriod      String?
  salaryTextRaw     String?

  // Work authorization
  visaSponsored     Boolean?
  workAuthorization String?
  sponsorshipNotes  String?

  // Extracted content
  description       String?  @db.Text
  descriptionClean  String?  @db.Text
  requirementsJson  Json     @default("[]")
  skillsJson        Json     @default("[]")
  toolsJson         Json     @default("[]")
  experienceMin     Int?
  experienceMax     Int?

  // pgvector embedding — Prisma can't type this; written/queried via raw SQL.
  // Dimension 768 matches the default embed model (text-embedding-004). The
  // column, the `vector` extension, and the HNSW ANN index are created in the
  // hand-authored migration (Prisma emits only this Unsupported placeholder).
  embedding         Unsupported("vector(768)")?
  embeddedAt        DateTime?
  embedModel        String?

  // Per-job cost attribution (admin cost tracking). acquisitionCostUsd = the paid
  // scraper spend amortized onto this posting at first insert (callCost / itemsReturned;
  // 0 for free ATS/aggregator sources). embedCostUsd = the embedding spend for this row.
  // totalCost = acquisition + embed; summed by source for the unified per-source view.
  // Null on legacy rows ingested before cost tracking existed.
  acquisitionCostUsd Float?
  embedCostUsd       Float?

  // GLOBAL dedup identity: `${source}:${company}:${sourceJobId}` (lowercased),
  // computed by normalizeJob. Upserted on by the ingestor (one row per posting).
  dedupeKey         String   @unique
  contentHash       String?

  // Lifecycle / freshness
  postingStatus     String?  // active | closed | unknown
  postedAt          DateTime?
  expiresAt         DateTime?
  firstSeenAt       DateTime @default(now())
  lastSeenAt        DateTime @default(now())
  ingestRunId       String?  // optional pointer to the GlobalIngestRun that last touched it
  rawJson           Json?
  schemaVersion     String?  @default("global.v1")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  jobs              Job[]    // per-user references back into the pool

  @@index([company])
  @@index([postingStatus, postedAt])
  @@index([remoteType])
  @@index([sourceName])   // admin job-pool explorer: filter/group by source
  @@index([firstSeenAt])  // admin explorer ordering + freshness trend
}

// Pool-level ingestion metrics for the scheduled global ingestor (the analog of
// ApplicationRun, but user-agnostic). Tracks one global fetch cycle.
model GlobalIngestRun {
  id                 String    @id @default(cuid())
  sourceTag          String    @default("free") // free (ATS + aggregators) | apify (paid scrapers)
  status             String    @default("CREATED") // CREATED | FETCHING | EMBEDDING | COMPLETED | FAILED
  boardsFetched      Int       @default(0)
  keywordsUsed       Int       @default(0) // distinct demand role-keywords steering search APIs
  postingsDiscovered Int       @default(0)
  postingsInserted   Int       @default(0)
  postingsUpdated    Int       @default(0)
  postingsEmbedded   Int       @default(0)
  // Per-run cost (admin cost tracking). costUsd = scraper spend this run (Apify;
  // 0 for the free track), embedCostUsd = embedding spend this run, callCount =
  // number of scraper calls/sources recorded (see ScraperUsageEvent).
  costUsd            Float     @default(0)
  embedCostUsd       Float     @default(0)
  callCount          Int       @default(0)
  errorMessage       String?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  scraperEvents      ScraperUsageEvent[]
}

// Per-CALL scraper ledger (the analog of AIUsageEvent, for job pulling). One row
// per actor invocation (Apify: per keyword/query) or per free source per run.
// Powers per-keyword cost drill-down, source reliability (status/latency), and the
// dedup-waste metric (itemsNew vs itemsReturned). costUsd is 0 for free sources.
model ScraperUsageEvent {
  id             String           @id @default(cuid())
  runId          String?
  run            GlobalIngestRun? @relation(fields: [runId], references: [id])
  kind           String           // apify | ats | aggregator
  source         String           // linkedin | indeed | hiringcafe | greenhouse | remotive | ...
  actorName      String?          // Apify actor slug when kind=apify
  query          String?          // the keyword/search term that drove the call (Apify)
  itemsReturned  Int              @default(0)
  itemsNew       Int              @default(0)
  itemsDuplicate Int              @default(0)
  costUsd        Float            @default(0)
  estimated      Boolean          @default(false) // true = fallback per-result rate (actor reported no usage)
  durationMs     Int              @default(0)
  status         String           @default("ok")  // ok | error | capped
  errorMessage   String?
  createdAt      DateTime         @default(now())

  @@index([source, createdAt])
  @@index([runId])
  @@index([createdAt])
}

// Daily storage snapshot (admin infra cost tracking + cloud-migration budgeting).
// Written once/day by snapshotStorage(). `scope` selects the breakdown dimension
// and `key` the bucket within it. Bytes are exact Postgres on-disk sizes. Enables
// growth-rate, runway, and projected $/GB-month cloud cost (DB vs blob).
model StorageDailyMetric {
  id         String   @id @default(cuid())
  date       DateTime @db.Date
  scope      String   // database | table | source | artifactType | user
  key        String   // table name | source name | artifact type | userId | "_" (database)
  bytesTotal BigInt   @default(0)
  bytesHeap  BigInt   @default(0)
  bytesIndex BigInt   @default(0)
  bytesToast BigInt   @default(0)
  rowCount   BigInt   @default(0)
  createdAt  DateTime @default(now())

  @@unique([date, scope, key])
  @@index([scope, date])
}

// Admin-editable runtime settings (spec Pt 18). Key→JSON value overlay on top of
// env config so the admin can change spend caps, the global-run schedule, the
// 50/50 split, etc. LIVE without a redeploy. Read via runtime-settings.ts.
model AdminSetting {
  key       String   @id
  value     String   // JSON-encoded
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// Durable, content-keyed novelty ledger — SURVIVES the weekly pool purge. With
// ~70% of postings lacking a real postedAt, firstSeenAt is the freshness signal,
// and the purge would otherwise reset it (a still-open job re-pulled next week
// would look 24h-fresh again). JobSeen remembers the GLOBAL first sighting per
// canonicalKey so upsertPosting can carry it forward. Keyed by the source-agnostic
// canonicalKey (job-normalizer.canonicalKeyFor). Retained longer than the pool.
model JobSeen {
  canonicalKey String   @id
  firstSeenAt  DateTime @default(now()) // global first sighting, ever
  lastSeenAt   DateTime @default(now())
  timesSeen    Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([lastSeenAt])
}

// Per-user, content-keyed "already surfaced" ledger — also survives the purge and
// is source-agnostic, so a user is never re-shown the same logical job after a
// purge or from a different source. Complements the applied-guard (postingId based).
model UserJobSeen {
  id           String   @id @default(cuid())
  userId       String
  canonicalKey String
  status       String   @default("shown") // shown | applied
  firstShownAt DateTime @default(now())
  lastShownAt  DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, canonicalKey])
  @@index([userId])
}

// Per-source per-day metrics + cost (spec Pt 14). Drives the admin Job-Pulling
// Expenses page, the cost_per_high_match_job yield metric, and the daily budget
// rebalance. `costUsd` is the real-dollar Apify spend attributed to the source.
model SourceDailyMetrics {
  id                String   @id @default(cuid())
  date              DateTime @db.Date           // calendar day bucket
  source            String                       // linkedin | indeed | hiringcafe | greenhouse | ...
  actorName         String?
  totalScraped      Int      @default(0)
  totalNew          Int      @default(0)
  totalDuplicates   Int      @default(0)
  jobsHighMatch     Int      @default(0)         // postings that became an 80+ match
  jobsSelected      Int      @default(0)
  applied           Int      @default(0)
  costUsd           Float    @default(0)         // real-dollar spend (Apify usageTotalUsd / rate)
  actorRuns         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([date, source])
  @@index([date])
}

// T2 — per-user job row. In the global-pool architecture this is a THIN per-user
// handle: a candidate materialized for a specific user from the shared JobPosting
// pool (postingId set), OR a manually pasted job not in the pool (postingId null,
// fields inline). Application.jobId / JobMatch.jobId reference this, so the
// downstream document pipeline is unaffected by the pool refactor.
model Job {
  id                String      @id @default(cuid())
  userId            String?
  user              User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  runId             String?
  run               ApplicationRun? @relation("RunJobs", fields: [runId], references: [id])
  postingId         String?     // link to the global pool (null = manual paste)
  posting           JobPosting? @relation(fields: [postingId], references: [id])
  sourceId          String?
  source            JobSource?  @relation(fields: [sourceId], references: [id])

  // Source / provenance
  sourceName        String?     // greenhouse | lever | manual | ...
  sourceJobId       String?
  externalId        String?
  jobUrl            String?
  applyUrl          String?
  atsPlatform       String?     // greenhouse | lever | ashby | workday | unknown

  // Core fields
  title             String
  normalizedTitle   String?
  company           String
  companyDomain     String?
  department        String?
  industry          String?
  location          String?
  isRemote          Boolean?
  remoteType        String?     // onsite | hybrid | remote | unknown
  employmentType    String?     // full_time | contract | internship | part_time | temporary
  seniority         String?     // intern | entry | junior | mid | senior | lead | manager | unknown

  // Compensation
  salaryMin         Int?
  salaryMax         Int?
  salaryCurrency    String?
  salaryPeriod      String?     // yearly | hourly | monthly | unknown
  salaryTextRaw     String?

  // Work authorization
  visaSponsored     Boolean?
  workAuthorization String?
  sponsorshipNotes  String?

  // Extracted content
  description       String?     @db.Text
  descriptionClean  String?     @db.Text
  requirementsJson  Json        @default("[]")
  skillsJson        Json        @default("[]")
  toolsJson         Json        @default("[]")
  experienceMin     Int?
  experienceMax     Int?

  // Dedup / integrity (embeddings now live on JobPosting.embedding in the pool)
  dedupeKey         String?
  contentHash       String?

  // Lifecycle
  postingStatus     String?     // active | closed | unknown
  postedAt          DateTime?
  expiresAt         DateTime?
  ingestedAt        DateTime?
  rawJson           Json?
  schemaVersion     String?     @default("t2.v1")
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  matches           JobMatch[]
  applications      Application[]

  @@unique([userId, postingId])
  @@index([userId, runId])
  @@index([company])
}

model JobMatch {
  id          String   @id @default(cuid())
  jobId       String
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId      String
  score       Int
  decision    String
  reasonsJson Json     @default("[]")
  risksJson   Json     @default("[]")
  // Two-stage retrieval provenance (additive): how this match was reached.
  stage       String?  // candidate | reranked
  vectorScore Float?   // cosine similarity from candidate generation (stage A)
  featureScore Float?  // deterministic feature score before LLM rerank (stage B)
  // Explainable multi-factor scoring (spec Pt 10-12, 16) — additive.
  statusTier  String?  // APPLY_NOW | STRONG_MATCH | GOOD_MATCH | BACKUP | LOW_PRIORITY | REJECTED
  reasonCodesJson Json @default("[]") // structured ReasonCode[]
  gateStatus  String?  // passed | rejected
  failedGatesJson Json @default("[]") // NegativeCode[] of failed hard gates
  // Per-factor 0-100 breakdown
  roleFitScore       Int?
  experienceFitScore Int?
  skillScore         Int?
  atsScore           Int?
  locationScore      Int?
  workAuthScore      Int?
  domainScore        Int?
  compensationScore  Int?
  recencyScore       Int?
  feasibilityScore   Int?
  createdAt   DateTime @default(now())

  @@unique([jobId, userId])
}

// ─── Application Run ─────────────────────────────────────────────────────────

// T3 — ingestion_runs. Tracks whether a job-ingestion workflow actually ran.
model ApplicationRun {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status            RunStatus @default(CREATED)

  triggerType       String?   // payment_activated | manual_test | scheduled | retry
  requestedSourcesJson Json   @default("[]")

  jobsDiscovered    Int       @default(0)  // jobs found across all sources
  jobsInserted      Int       @default(0)  // new T2 rows written
  jobsUpdated       Int       @default(0)
  duplicatesSkipped Int       @default(0)
  jobsShortlisted   Int       @default(0)
  jobsGated         Int       @default(0)  // candidates rejected by hard gates before scoring
  gateFailuresJson  Json      @default("{}") // { NegativeCode: count } aggregate for this run
  applicationsTotal Int       @default(0)
  applicationsDone  Int       @default(0)

  errorMessage      String?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  applications      Application[]
  usageEvents       AIUsageEvent[]
  jobs              Job[]     @relation("RunJobs")
}

enum RunStatus {
  CREATED
  DISCOVERING_JOBS
  PARSING_JOBS
  SCORING
  GENERATING_DOCUMENTS
  WAITING_FOR_APPROVAL
  APPLYING
  COMPLETED
  FAILED
  CANCELLED
}

// ─── Application ─────────────────────────────────────────────────────────────

model Application {
  id                     String            @id @default(cuid())
  userId                 String
  user                   User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  runId                  String?
  run                    ApplicationRun?   @relation(fields: [runId], references: [id])
  jobId                  String?
  job                    Job?              @relation(fields: [jobId], references: [id])
  resumeId               String?
  resume                 Resume?           @relation(fields: [resumeId], references: [id])
  company                String
  roleTitle              String
  jobUrl                 String?
  atsPlatform            String?
  matchScore             Int?
  status                 ApplicationStatus @default(DISCOVERED)
  applyMode              ApprovalMode?
  tailoredResumeUrl      String?
  coverLetterUrl         String?
  coldEmailText          String?           @db.Text
  hiringManagerEmail     String?
  submissionConfirmation String?
  failureReason          String?
  retryCount             Int               @default(0)
  followUpDate           DateTime?
  notes                  String?           @db.Text
  appliedAt              DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  documents              ApplicationDocument[]
  answers                ApplicationAnswer[]
  contacts               RecruiterContact[]
  events                 ApplicationEvent[]
  usageEvents            AIUsageEvent[]

  // Backs the monthly-usage / status aggregations in usage-limits + billing.
  @@index([userId, status, createdAt])
}

enum ApplicationStatus {
  DISCOVERED
  SHORTLISTED
  MATCHED
  GENERATED
  TAILORED_RESUME_READY
  NEEDS_APPROVAL
  APPROVED
  APPLICATION_STARTED
  FORM_FILLED_READY_TO_SUBMIT
  READY_FOR_USER_SUBMIT
  APPLIED
  ASSISTED_REQUIRED
  CAPTCHA_REQUIRED
  LOGIN_REQUIRED
  QUESTION_NEEDS_REVIEW
  DRAFT_ONLY
  DECLINED
  FAILED
  FAILED_TECHNICAL
  SKIPPED_UNSUPPORTED
  ARCHIVED
  FOLLOW_UP_DUE
}

model ApplicationDocument {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type          String      // resume | cover_letter | qa_answers | cold_email | application_package
  fileUrl       String?
  content       String?     @db.Text
  metadataJson  Json?       // structured side-data, e.g. the ATS match analysis for a tailored resume
  version       Int         @default(1)
  createdAt     DateTime    @default(now())
}

model ApplicationAnswer {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  question      String      @db.Text
  answer        String      @db.Text
  isSensitive   Boolean     @default(false)
  approved      Boolean?
  createdAt     DateTime    @default(now())
}

model RecruiterContact {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  name          String?
  title         String?
  email         String?
  linkedinUrl   String?
  source        String?
  createdAt     DateTime    @default(now())
}

model ApplicationEvent {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type          String
  description   String?
  metadata      Json?
  createdAt     DateTime    @default(now())
}

// ─── AI Usage ────────────────────────────────────────────────────────────────

model AIUsageEvent {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  runId            String?
  run              ApplicationRun? @relation(fields: [runId], references: [id])
  applicationId    String?
  application      Application?    @relation(fields: [applicationId], references: [id])
  featureName      String
  model            String
  inputTokens      Int             @default(0)
  outputTokens     Int             @default(0)
  cacheReadTokens  Int             @default(0)
  estimatedCostUsd Float           @default(0)
  // Measured token split for this call: { input: {factor: tokens}, output: {section: tokens} },
  // apportioned to the billed input/output totals. Powers the cost-factor drill-down.
  breakdownJson    Json?
  createdAt        DateTime        @default(now())

  // Back the billing aggregations: per-user/time and company-wide/time scans.
  @@index([userId, createdAt])
  @@index([createdAt])
}

// ─── Billing ─────────────────────────────────────────────────────────────────

model Plan {
  id                   String   @id @default(cuid())
  name                 String   @unique
  slug                 String   @unique
  priceMonthly         Float
  priceYearly          Float?
  applicationsPerDay   Int      @default(10)
  applicationsPerMonth Int
  tailoringsPerMonth   Int
  automationEnabled    Boolean  @default(false)
  analyticsEnabled     Boolean  @default(false)
  featuresJson         Json     @default("[]")
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  subscriptions        Subscription[]
}

model Subscription {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId             String
  plan               Plan      @relation(fields: [planId], references: [id])
  paymentProvider    String    @default("test")  // stripe | manual | test
  stripeCustomerId   String?   @unique
  stripeSubId        String?   @unique
  status             String    @default("inactive") // inactive | trial | active | past_due | cancelled
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

// T4 — subscription_events. Records WHY ingestion was triggered. The ingestion
// worker is kicked off by a trusted backend payment event, never by the frontend.
model SubscriptionEvent {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  paymentProvider   String    // stripe | manual | test
  paymentCustomerId String?
  subscriptionId    String?

  eventType         String    // checkout_completed | payment_succeeded | subscription_activated | payment_failed | subscription_cancelled
  oldStatus         String?
  newStatus         String?

  planName          String?
  amountPaid        Float?
  currency          String?

  processingStatus  String    @default("processed") // received | processed | failed
  rawEventJson      Json?
  processedAt       DateTime?
  createdAt         DateTime  @default(now())

  @@index([userId, newStatus])
}
