# ─────────────────────────────────────────────────────────────────────────────
# JobPilot configuration. Copy to `.env` and fill in. All server config is read
# through server/lib/config.ts — never hardcode secrets elsewhere.
# Modes: NODE_ENV = development | test | production
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# ── HTTP / URLs ──────────────────────────────────────────────────────────────
PORT=3001
UI_ORIGIN=http://localhost:5173
# Public URL of this API (used to build Stripe return URLs in prod).
PUBLIC_URL=http://localhost:5173
LOG_LEVEL=info

# ── PostgreSQL (required) ────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/jobpilot

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# ── Anthropic / Claude (optional — server degrades gracefully without it) ─────
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI-compatible provider for all non-tailoring AI tasks (scoring, parsing,
# Q&A, cover letter, cold email) + embeddings. Defaults target Google Gemini's
# free tier; point AI_COMPAT_BASE_URL at Groq/OpenRouter/Ollama to switch.
AI_COMPAT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_COMPAT_API_KEY=
AI_MODEL_FLASH=gemini-2.5-flash
AI_MODEL_PRO=gemini-2.5-pro
AI_EMBED_MODEL=text-embedding-004
# Optional model overrides (else server/services/ai/model-config.ts defaults apply)
# ANTHROPIC_MODEL_OPUS=claude-opus-4-8
# ANTHROPIC_MODEL_SONNET=claude-sonnet-4-6
# ANTHROPIC_MODEL_HAIKU=claude-haiku-4-5-20251001

# ── Stripe (subscriptions). Use test keys (sk_test_…/whsec_…) in dev/test. ────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Stripe Price ids per plan slug (Starter 30/day, Pro 50/day, Max 75/day):
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_MAX=price_...

# Monthly infra cost estimate (USD) for the admin financials/margin view.
INFRA_MONTHLY_USD=0
# Optional explicit redirect URLs (else derived from UI_ORIGIN):
# STRIPE_SUCCESS_URL=http://localhost:5173/billing?status=success
# STRIPE_CANCEL_URL=http://localhost:5173/billing?status=cancelled

# ── Artifact storage (generated resumes/packages) ────────────────────────────
# Generated document bytes are stored in Postgres (the Artifact table) and served
# via the auth'd /api/files route — no external object store. Only the upload cap
# is configurable.
MAX_UPLOAD_MB=8

# ── Automation / pipeline ────────────────────────────────────────────────────
# Automation mode:
#   assisted (default) = prepare the autofill package + documents and hand off to
#     the user. No headless browser, so the prod image stays small / memory low.
#   auto = headless Playwright form-fill (requires Chromium in the runtime image
#     and >=1GiB Cloud Run memory; live ATS forms are fragile).
AUTOMATION_MODE=assisted
# In AUTOMATION_MODE=auto only: whether automation actually clicks submit.
# Off = fill + leave for the user. CAPTCHA/login/OTP always require the user.
AUTO_SUBMIT=false
MAX_JOBS_PER_RUN=60
DEFAULT_APPLICATIONS_PER_DAY=10

# Background retry of applications that failed during document generation.
RETRY_WORKER_ENABLED=true
RETRY_INTERVAL_MINUTES=15
RETRY_MAX_ATTEMPTS=3
RETRY_BATCH_SIZE=10

# Daily auto-apply scheduler: once per day at DAILY_RUN_HOUR, start a run for each
# active subscriber who hasn't already had a scheduled run that day. DAILY_RUN_HOUR
# is server-LOCAL time (UTC on Cloud Run unless the TZ env is set).
DAILY_SCHEDULER_ENABLED=true
DAILY_RUN_HOUR=8
DAILY_SCHEDULER_INTERVAL_MINUTES=30
# Refresh the shared global job pool once/day at/after this hour, BEFORE the
# per-user runs at DAILY_RUN_HOUR read from it. Keep earlier than DAILY_RUN_HOUR.
GLOBAL_INGEST_HOUR=6

# ── Freshness ("daily-new" 24h policy) ───────────────────────────────────────
# Per-user matching surfaces only postings new within MATCH_FRESHNESS_HOURS (by
# firstSeenAt OR postedAt). If fewer than MATCH_MIN_FRESH_CANDIDATES are found, it
# widens ONCE to MATCH_FRESHNESS_FALLBACK_HOURS so slow days still fill a shortlist.
MATCH_FRESHNESS_HOURS=24
MATCH_FRESHNESS_FALLBACK_HOURS=168
MATCH_MIN_FRESH_CANDIDATES=40
# Pool retention: postings not re-seen within this many days are soft-expired
# (dropped from matching; re-activated if seen again).
POOL_RETENTION_DAYS=21

# ── Job sources (free aggregator APIs) ───────────────────────────────────────
# Keyless sources (Remotive, RemoteOK, Arbeitnow, The Muse) need no config. Adzuna
# and USAJOBS require free registration; their adapters self-skip when unset.
# Adzuna: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us
# USAJOBS: https://developer.usajobs.gov/  (USER_AGENT must be a contact email)
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=you@example.com
# The Muse: optional key raises the rate limit (works unauthenticated otherwise).
THEMUSE_API_KEY=
# Pages pulled per keyword'd aggregator (Adzuna/Muse/USAJOBS) per ingest cycle.
INGEST_MAX_PAGES_PER_SOURCE=2
# Demand-driven ingestion: how many distinct target-role keywords / locations from
# ACTIVE subscribers steer the search APIs (Adzuna/USAJOBS). Bounds query volume.
INGEST_MAX_KEYWORDS=30
INGEST_MAX_LOCATIONS=10

# ── Per-source enable flags (Part 1.7) ───────────────────────────────────────
# Turn any free source off without a redeploy. Keyless fresh sources default ON.
# See docs/SOURCES.md for the full table (method / key / timestamp / ToS).
SOURCE_REMOTIVE=true
SOURCE_REMOTEOK=true
SOURCE_ARBEITNOW=true
SOURCE_THEMUSE=true
SOURCE_ADZUNA=true
SOURCE_USAJOBS=true
SOURCE_JOBICY=true            # jobicy.com/api/v2 — keyless, fresh (pubDate)
SOURCE_WEWORKREMOTELY=true    # weworkremotely.com category RSS — keyless, fresh
SOURCE_HIMALAYAS=true         # himalayas.app/jobs/api — keyless, fresh
SOURCE_WORKINGNOMADS=true     # workingnomads.com/api — keyless, fresh
SOURCE_HACKERNEWS=false       # HN "Who is hiring" — deferred (lower parse precision)
# Deferred key-required free sources (adapters self-skip until a key is set):
FINDWORK_API_KEY=             # findwork.dev/developers
JOOBLE_API_KEY=               # jooble.org/api/about
REED_API_KEY=                 # reed.co.uk/developers

# ── ATS company registry (Track 1: wide coverage) ────────────────────────────
# Curated starter seed: `npm run seed:sources` (~90 companies, vendored).
# Wide import from public GitHub datasets: `npm run seed:registry` (tens of
# thousands). Toggle which datasets to pull (all MIT-licensed):
ATS_SEED_STAPPLY=true        # stapply-ai/ats-scrapers — CSV per ATS, ~63k, cleanest
ATS_SEED_FEASHLIAA=false     # Feashliaa/job-board-aggregator — ~95k GH/Lever/Ashby slugs
ATS_SEED_OPENJOBS=false      # outscal/OpenJobs — ~12k, ATS inferred from URLs
# Weekly auto-resync of the above into JobSource (manual seed works regardless):
ATS_REGISTRY_SYNC_ENABLED=false
# Feasibility cap: boards fetched per ingest run. Demand-resolved + fallback boards
# are always crawled; the rest of the registry fills up to this, rotated
# least-recently-checked-first (so the whole registry is covered over days).
INGEST_MAX_BOARDS_PER_RUN=1500
# COST LEVER: cap embeddings computed per ingest cycle. Embeddings are the real
# cost of a large registry-synced pool; the rest embed on later cycles (or lazily
# when first matched). Raise once you've observed cost. 0 = unlimited.
INGEST_MAX_EMBEDDINGS_PER_RUN=2000

# ── Admin dashboard (http://localhost:5174) ──────────────────────────────────
# Comma-separated emails granted admin access (bootstraps the first admin; can
# also flip User.isAdmin in the DB). Required to reach /api/admin/* + billing.
ADMIN_EMAILS=

# ── Apify paid scrapers (Track 2: LinkedIn / Indeed / Hiring Cafe) ────────────
# Adapters self-skip without a token. Enable sources + set per-run caps in the
# admin dashboard (Sources & Scrapers). Jobright has no actor (reserved/disabled).
APIFY_TOKEN=
# Optional actor slug overrides (defaults shown):
# APIFY_ACTOR_LINKEDIN=bebity/linkedin-jobs-scraper
# APIFY_ACTOR_INDEED=misceres/indeed-scraper
# APIFY_ACTOR_HIRINGCAFE=automation-lab/hiring-cafe-jobs-scraper
# Max distinct demand keywords sent to the (paid) scrapers per run (cost bound).
APIFY_MAX_KEYWORDS=5

# ── Notifications (email) ────────────────────────────────────────────────────
# Default "log" transport writes notifications to the log — no provider keys
# needed locally. Set NOTIFY_EMAIL_TRANSPORT=smtp + a real client to send mail.
NOTIFY_EMAIL_ENABLED=true
NOTIFY_EMAIL_TRANSPORT=log
NOTIFY_FROM_ADDRESS=JobPilot <no-reply@jobpilot.local>
