# ─────────────────────────────────────────────────────────────────────────────
# JobPilot configuration. Copy to `.env` and fill in. All server config is read
# through server/lib/config.ts — never hardcode secrets elsewhere.
# Modes: NODE_ENV = development | test | production
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# ── HTTP / URLs ──────────────────────────────────────────────────────────────
PORT=3001
UI_ORIGIN=http://localhost:5173
# Public URL of this API (used to build Stripe return URLs in prod).
PUBLIC_URL=http://localhost:5173
LOG_LEVEL=info

# ── PostgreSQL (required) ────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/jobpilot

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# ── Anthropic / Claude (optional — server degrades gracefully without it) ─────
ANTHROPIC_API_KEY=sk-ant-...
# Optional model overrides (else server/services/ai/model-config.ts defaults apply)
# ANTHROPIC_MODEL_OPUS=claude-opus-4-8
# ANTHROPIC_MODEL_SONNET=claude-sonnet-4-6
# ANTHROPIC_MODEL_HAIKU=claude-haiku-4-5-20251001

# ── Stripe (subscriptions). Use test keys (sk_test_…/whsec_…) in dev/test. ────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Stripe Price ids per plan slug:
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
# Optional explicit redirect URLs (else derived from UI_ORIGIN):
# STRIPE_SUCCESS_URL=http://localhost:5173/billing?status=success
# STRIPE_CANCEL_URL=http://localhost:5173/billing?status=cancelled

# ── Artifact storage (generated resumes/packages) ────────────────────────────
# Generated document bytes are stored in Postgres (the Artifact table) and served
# via the auth'd /api/files route — no external object store. Only the upload cap
# is configurable.
MAX_UPLOAD_MB=8

# ── Automation / pipeline ────────────────────────────────────────────────────
# Automation mode:
#   assisted (default) = prepare the autofill package + documents and hand off to
#     the user. No headless browser, so the prod image stays small / memory low.
#   auto = headless Playwright form-fill (requires Chromium in the runtime image
#     and >=1GiB Cloud Run memory; live ATS forms are fragile).
AUTOMATION_MODE=assisted
# In AUTOMATION_MODE=auto only: whether automation actually clicks submit.
# Off = fill + leave for the user. CAPTCHA/login/OTP always require the user.
AUTO_SUBMIT=false
MAX_JOBS_PER_RUN=60
DEFAULT_APPLICATIONS_PER_DAY=10

# Background retry of applications that failed during document generation.
RETRY_WORKER_ENABLED=true
RETRY_INTERVAL_MINUTES=15
RETRY_MAX_ATTEMPTS=3
RETRY_BATCH_SIZE=10

# ── Notifications (email) ────────────────────────────────────────────────────
# Default "log" transport writes notifications to the log — no provider keys
# needed locally. Set NOTIFY_EMAIL_TRANSPORT=smtp + a real client to send mail.
NOTIFY_EMAIL_ENABLED=true
NOTIFY_EMAIL_TRANSPORT=log
NOTIFY_FROM_ADDRESS=JobPilot <no-reply@jobpilot.local>
